# Operator personalization template
#
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored
# and must never be committed. Every value below is a placeholder — replace the
# angle-bracket text with your own, or leave a variable unset to take the
# documented default.
#
# See docs/guides/environment-configuration.md and
# docs/guides/operator-personalization.md for how each variable maps onto the
# routing scripts.

# --- Runtime home -----------------------------------------------------------
# Runtime homes are derived from your shell's $HOME; there is no baked-in path.
# Leave HOME to your shell default. Only set this if you run the agent under a
# home directory other than your login user's.
# HOME=<your-home>

# --- Save destination -------------------------------------------------------
# Optional. Absolute path to any folder where durable run captures should be
# saved. For an Obsidian setup this can be your vault path; for everyone else it
# can be any normal writable folder. Leave unset to fall back to
# ./local-runtime-artifacts/raw-capture/ from the current working directory.
# SAVE_DESTINATION_PATH=<path-to-save-folder>
# Legacy compatibility alias: OBSIDIAN_VAULT_PATH is still honored when set.

# --- Reportback routing (Discord) -------------------------------------------
# Secret. Env-only, never committed. Create a bot and paste its token here.
# DISCORD_BOT_TOKEN=<your-bot-token>
# Numeric IDs from your own Discord server. Right-click > Copy ID (developer
# mode) to obtain them. These are placeholders, not real IDs.
# DISCORD_GUILD_ID=<guild-id>
# DISCORD_CHANNEL_ID=<channel-id>
# DISCORD_THREAD_ID=<thread-id>
# DISCORD_THREAD_NAME=<thread-name>

# --- Public target account (adopter-set) ------------------------------------
# The GitHub account/org you would publish an extracted public copy under.
# This is a value you choose; there is no default.
# PUBLIC_TARGET_ACCOUNT=<your-github-account>

# --- Loading note ------------------------------------------------------------
# This template is not a secret store and is not always auto-loaded. Keep real
# values in an untracked `.env` and have your shell/orchestrator export them
# before launch.
